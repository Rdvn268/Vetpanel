generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLINIC_OWNER
  VETERINARIAN
  TECHNICIAN
  RECEPTIONIST
  ACCOUNTANT
  ADMIN
}

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CHECKUP
  VACCINATION
  SURGERY
  GROOMING
  EMERGENCY
  LAB_TEST
  FOLLOW_UP
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  INSURANCE
  OTHER
}

enum HospitalizationStatus {
  ACTIVE
  DISCHARGED
  DECEASED
  TRANSFERRED
}

enum InventoryCategory {
  DRUG
  VACCINE
  CONSUMABLE
  FOOD
  EQUIPMENT
  OTHER
}

model Clinic {
  id         String   @id @default(uuid())
  name       String
  address    String?
  phone      String?
  email      String?
  taxNumber  String?
  logo       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users        User[]
  clients      Client[]
  patients     Patient[]
  appointments Appointment[]
  inventory    InventoryItem[]
  invoices     Invoice[]

  @@map("clinics")
}

model User {
  id           String   @id @default(uuid())
  clinicId     String
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole
  isActive     Boolean  @default(true)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  appointments   Appointment[]   @relation("DoctorAppointments")
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]

  @@map("users")
}

model Client {
  id         String   @id @default(uuid())
  clinicId   String
  firstName  String
  lastName   String
  phone      String
  email      String?
  address    String?
  nationalId String?
  notes      String?
  balance    Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clinic   Clinic    @relation(fields: [clinicId], references: [id])
  patients Patient[]
  invoices Invoice[]

  @@map("clients")
}

model Patient {
  id              String    @id @default(uuid())
  clinicId        String
  clientId        String
  name            String
  species         String
  breed           String?
  sex             Sex       @default(UNKNOWN)
  birthDate       DateTime?
  color           String?
  microchipNumber String?
  photo           String?
  isNeutered      Boolean   @default(false)
  isDeceased      Boolean   @default(false)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  client           Client            @relation(fields: [clientId], references: [id])
  weightHistory    WeightRecord[]
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  vaccinations     Vaccination[]
  labTests         LabTest[]
  imagingRecords   ImagingRecord[]
  prescriptions    Prescription[]
  hospitalizations Hospitalization[]

  @@map("patients")
}

model WeightRecord {
  id        String   @id @default(uuid())
  patientId String
  weight    Decimal  @db.Decimal(5, 2)
  unit      String   @default("kg")
  date      DateTime @default(now())
  notes     String?

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("weight_records")
}

model Appointment {
  id           String            @id @default(uuid())
  clinicId     String
  patientId    String
  doctorId     String
  title        String
  type         AppointmentType   @default(CHECKUP)
  status       AppointmentStatus @default(SCHEDULED)
  startTime    DateTime
  endTime      DateTime
  notes        String?
  reminderSent Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        User           @relation("DoctorAppointments", fields: [doctorId], references: [id])
  medicalRecord MedicalRecord?

  @@map("appointments")
}

model MedicalRecord {
  id             String   @id @default(uuid())
  patientId      String
  doctorId       String
  appointmentId  String?  @unique
  date           DateTime @default(now())
  chiefComplaint String?
  symptoms       String?
  physicalExam   String?
  diagnosis      String?
  treatmentPlan  String?
  notes          String?
  attachments    String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient       Patient       @relation(fields: [patientId], references: [id])
  doctor        User          @relation(fields: [doctorId], references: [id])
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  prescriptions Prescription[]

  @@map("medical_records")
}

model Vaccination {
  id               String    @id @default(uuid())
  patientId        String
  vaccineName      String
  vaccineType      String?
  batchNumber      String?
  manufacturer     String?
  dateAdministered DateTime
  nextDueDate      DateTime?
  administeredBy   String?
  notes            String?
  createdAt        DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("vaccinations")
}

model LabTest {
  id          String    @id @default(uuid())
  patientId   String
  testName    String
  testType    String
  requestedBy String?
  requestDate DateTime  @default(now())
  resultDate  DateTime?
  status      String    @default("PENDING")
  notes       String?
  createdAt   DateTime  @default(now())

  patient Patient     @relation(fields: [patientId], references: [id])
  results LabResult[]

  @@map("lab_tests")
}

model LabResult {
  id           String  @id @default(uuid())
  labTestId    String
  paramName    String
  value        String?
  unit         String?
  refRangeLow  String?
  refRangeHigh String?
  isAbnormal   Boolean @default(false)

  labTest LabTest @relation(fields: [labTestId], references: [id])

  @@map("lab_results")
}

model ImagingRecord {
  id          String   @id @default(uuid())
  patientId   String
  imageType   String
  description String?
  fileUrl     String
  takenAt     DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("imaging_records")
}

model Prescription {
  id              String   @id @default(uuid())
  patientId       String
  doctorId        String
  medicalRecordId String?
  date            DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        User           @relation(fields: [doctorId], references: [id])
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  medications   PrescriptionMedication[]

  @@map("prescriptions")
}

model PrescriptionMedication {
  id             String @id @default(uuid())
  prescriptionId String
  medicationName String
  dosage         String
  frequency      String
  duration       String
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id])

  @@map("prescription_medications")
}

model Hospitalization {
  id           String                @id @default(uuid())
  patientId    String
  cageNumber   String?
  admittedAt   DateTime              @default(now())
  dischargedAt DateTime?
  reason       String?
  status       HospitalizationStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  patient      Patient                @relation(fields: [patientId], references: [id])
  dailyRecords HospitalizationRecord[]

  @@map("hospitalizations")
}

model HospitalizationRecord {
  id                String   @id @default(uuid())
  hospitalizationId String
  date              DateTime @default(now())
  temperature       Decimal? @db.Decimal(4, 1)
  weight            Decimal? @db.Decimal(5, 2)
  treatments        String?
  fluidTherapy      String?
  feeding           String?
  notes             String?
  createdBy         String?

  hospitalization Hospitalization @relation(fields: [hospitalizationId], references: [id])

  @@map("hospitalization_records")
}

model InventoryItem {
  id          String            @id @default(uuid())
  clinicId    String
  name        String
  category    InventoryCategory @default(OTHER)
  sku         String?
  barcode     String?
  quantity    Int               @default(0)
  unit        String            @default("adet")
  minQuantity Int               @default(0)
  costPrice   Decimal           @db.Decimal(10, 2)
  sellPrice   Decimal           @db.Decimal(10, 2)
  expiryDate  DateTime?
  supplier    String?
  notes       String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  invoiceItems InvoiceItem[]

  @@map("inventory_items")
}

model Invoice {
  id             String        @id @default(uuid())
  clinicId       String
  clientId       String
  invoiceNumber  String        @unique
  date           DateTime      @default(now())
  dueDate        DateTime?
  subtotal       Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  clinic   Clinic        @relation(fields: [clinicId], references: [id])
  client   Client        @relation(fields: [clientId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id              String  @id @default(uuid())
  invoiceId       String
  inventoryItemId String?
  description     String
  quantity        Int
  unitPrice       Decimal @db.Decimal(10, 2)
  totalPrice      Decimal @db.Decimal(10, 2)

  invoice       Invoice        @relation(fields: [invoiceId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@map("invoice_items")
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod @default(CASH)
  paidAt    DateTime      @default(now())
  reference String?
  notes     String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model Reminder {
  id          String    @id @default(uuid())
  patientId   String?
  clientId    String?
  type        String
  message     String
  scheduledAt DateTime
  sentAt      DateTime?
  method      String    @default("SMS")
  isSent      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("reminders")
}
